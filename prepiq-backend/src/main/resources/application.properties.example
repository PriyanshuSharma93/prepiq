spring.application.name=backend

# Database connection - replace with your local values
spring.datasource.url=jdbc:postgresql://localhost:5432/prepiq
spring.datasource.username=postgres
spring.datasource.password=YOUR_PASSWORD_HERE
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# Gemini API
gemini.api.key=YOUR_GEMINI_API_KEY_HERE
gemini.api.model=gemini-flash-latest

# JWT
jwt.secret=YOUR_RANDOM_SECRET_KEY_HERE_AT_LEAST_32_CHARACTERS
jwt.expiration-ms=86400000